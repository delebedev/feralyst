{
  "name": "feralyst",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings src",
    "typecheck": "tsc",
    "test": "bun test",
    "battle": "bun src/battle/battle-demo.ts",
    "build": "vite build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run assets:check && bun run test && bun run build",
    "assets": "bun scripts/build-creature-atlases.ts",
    "assets:check": "bun scripts/build-creature-atlases.ts --check"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.3.11"
}
